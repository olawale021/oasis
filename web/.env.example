# Cloudflare API token for wrangler (matchday.sh KV push + cf:deploy).
# Create at: dash.cloudflare.com -> profile -> API Tokens -> "Edit Cloudflare Workers" template.
# Zone Resources: "All zones from an account". Wrangler loads this file from web/.
CLOUDFLARE_API_TOKEN=your_token_here
CLOUDFLARE_ACCOUNT_ID=ee2ee894a87d4e5f9643f04696d0c748
ADMIN_PASSWORD=choose_a_long_password

# Telegram bot (also Worker secrets: wrangler secret put TELEGRAM_BOT_TOKEN etc.)
TELEGRAM_BOT_TOKEN=from_botfather
TELEGRAM_BOT_USERNAME=your_bot_handle_without_at
TELEGRAM_WEBHOOK_SECRET=random_string_given_to_setWebhook
TELEGRAM_DISPATCH_SECRET=random_string_shared_with_the_droplet
